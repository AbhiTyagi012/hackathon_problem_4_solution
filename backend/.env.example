APP_NAME=Decision Automation Platform
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Leave GROQ_API_KEY blank to run entirely on deterministic fallbacks (no network calls).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=30

# Leave GEMINI_API_KEY blank to run the purchase-history similarity rail on a
# deterministic offline fallback vector (no network calls).
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
